<?xml version="1.0" encoding="utf-8"?>
<!-- Sports and weather lines (HomeLines.java), inflated from a ViewStub after the home screen's first frame, and only
     when a feed address is set; HomeLines centres them between the top bar and the dock band. Weights are view tags
     (Fonts.java). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/lines"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:visibility="gone">
    <!-- size and margins come from the ViewStub in activity_main.xml -->

    <LinearLayout
        android:id="@+id/sport"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="start"
        android:orientation="vertical">

        <TextView
            android:id="@+id/sportLabel"
            style="@style/LineLabel"
            android:drawablePadding="7dp" />

        <LinearLayout
            android:id="@+id/headline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:orientation="horizontal"
            android:baselineAligned="true">

            <TextView android:id="@+id/hA" style="@style/HeadName" />
            <TextView android:id="@+id/hScoreA" style="@style/HeadScore" />
            <TextView android:id="@+id/hV" style="@style/HeadV" android:text="V" android:layout_gravity="center_vertical" />
            <TextView android:id="@+id/hScoreB" style="@style/HeadScore" />
            <TextView android:id="@+id/hB" style="@style/HeadName" />
            <TextView android:id="@+id/hLoc" style="@style/HeadLoc" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/then1"
            style="@style/ThenRow">
            <TextView android:id="@+id/then1Label" style="@style/ThenLabel" />
            <TextView android:id="@+id/then1Time" style="@style/ThenTime" />
            <TextView android:id="@+id/then1Match" style="@style/ThenMatch" />
            <TextView android:id="@+id/then1Comp" style="@style/ThenComp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/then2"
            style="@style/ThenRow">
            <TextView android:id="@+id/then2Label" style="@style/ThenLabel" />
            <TextView android:id="@+id/then2Time" style="@style/ThenTime" />
            <TextView android:id="@+id/then2Match" style="@style/ThenMatch" />
            <TextView android:id="@+id/then2Comp" style="@style/ThenComp" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/weather"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:orientation="vertical"
        android:gravity="end">

        <LinearLayout
            android:id="@+id/weatherCols"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal" />

        <!-- under the columns, so the cities line up with the sport label above -->
        <TextView
            android:id="@+id/weatherAsOf"
            style="@style/LineAsOf"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="0dp"
            android:visibility="gone" />
    </LinearLayout>
</FrameLayout>
