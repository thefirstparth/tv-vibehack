<?xml version="1.0" encoding="utf-8"?>
<!--
  Launcher configuration. Edit this file, then run launcher/build-and-install.sh.
  Package names: on the TV run `pm list packages` (tools/tv.py 'pm list packages').
-->
<resources>

    <!-- Apps pinned to the dock row at the bottom, in this order. Missing apps are skipped. -->
    <string-array name="dock_apps">
        <item>com.google.android.youtube.tv</item>
        <item>com.netflix.ninja</item>
        <item>in.startv.hotstar</item>
        <item>com.fancode.tv</item>                 <!-- FanCode -->
    </string-array>

    <!-- Grid tiles shown first, right after the dock, in this order. Everything else follows A–Z. -->
    <string-array name="grid_order">
        <item>com.apple.atve.androidtv.appletv</item>   <!-- Apple TV -->
        <item>com.sonyliv</item>                        <!-- Sony LIV -->
        <item>com.formulaone.production</item>          <!-- F1 TV -->
        <item>com.spotify.tv.android</item>             <!-- Spotify -->
        <item>com.android.vending</item>                <!-- Play Store -->
    </string-array>

    <!-- Apps never shown as tiles (e.g. the Live TV app, which the Inputs menu already covers). -->
    <string-array name="hidden_apps">
        <item>com.mitv.livetv</item>
        <item>com.mitv.gallery</item>
        <item>com.xiaomi.mitv.mediaexplorer</item>      <!-- Media Player -->
        <item>com.google.android.videos</item>          <!-- Google Play Movies & TV -->
    </string-array>

    <!-- The TV's Live TV / tuner app, offered at the end of the Inputs menu. Leave empty to omit. -->
    <string name="live_tv_package" translatable="false">com.mitv.livetv</string>

    <!-- Tiles per row in the grid; the dock always has this many slots. -->
    <integer name="columns">4</integer>
</resources>
