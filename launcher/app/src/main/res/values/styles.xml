<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.TvHome" parent="android:Theme.Material.NoActionBar.Fullscreen">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:colorBackground">@android:color/black</item>
        <item name="android:windowAnimationStyle">@null</item>
    </style>

    <!-- Frosted pill, tvOS style. -->
    <style name="TopButton">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">42dp</item>
        <item name="android:layout_marginStart">10dp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">20dp</item>
        <item name="android:gravity">center</item>
        <item name="android:background">@drawable/pill_bg</item>
        <item name="android:textColor">@drawable/pill_text</item>
        <item name="android:textSize">15sp</item>
        <item name="android:fontFamily">@font/outfit</item>
        <item name="android:tag">w500</item>
        <item name="android:letterSpacing">0.01</item>
        <item name="android:drawablePadding">9dp</item>
        <item name="android:drawableTint">@drawable/pill_text</item>
        <item name="android:focusable">true</item>
        <item name="android:clickable">true</item>
    </style>

    <!-- Home-screen lines (design B3): Outfit only, each weight fixed here, never changed while running. -->
    <style name="LineBase">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:fontFamily">@font/outfit</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:singleLine">true</item>
        <item name="android:ellipsize">none</item>
    </style>
    <style name="LineLabel" parent="LineBase">
        <item name="android:textSize">12sp</item>
        <item name="android:tag">w600</item>
        <item name="android:letterSpacing">0.14</item>
        <item name="android:textColor">#8CFFFFFF</item>
    </style>
    <style name="LineAsOf" parent="LineBase">
        <item name="android:textSize">12sp</item>
        <item name="android:tag">w600</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:textColor">#FFFFB347</item>
        <item name="android:layout_marginBottom">6dp</item>
    </style>
    <style name="HeadName" parent="LineBase">
        <item name="android:textSize">44sp</item>
        <item name="android:tag">w200</item>
        <item name="android:letterSpacing">-0.015</item>
        <item name="android:textColor">#FFFFFFFF</item>
    </style>
    <!-- Scores and the clock use Outfit's tabular digits (tnum), so they keep their width as the digits change. -->
    <style name="HeadScore" parent="HeadName">
        <item name="android:tag">w600</item>
        <item name="android:fontFeatureSettings">tnum</item>
        <item name="android:layout_marginStart">17dp</item>
        <item name="android:layout_marginEnd">17dp</item>
        <item name="android:visibility">gone</item>
    </style>
    <style name="HeadV" parent="LineBase">
        <item name="android:textSize">19sp</item>
        <item name="android:tag">w600</item>
        <item name="android:letterSpacing">0.14</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textColor">#A6FFFFFF</item>
        <item name="android:layout_marginStart">14dp</item>
        <item name="android:layout_marginEnd">14dp</item>
    </style>
    <style name="HeadLoc" parent="LineBase">
        <item name="android:textSize">20sp</item>
        <item name="android:tag">w400</item>
        <item name="android:textColor">#52FFFFFF</item>
        <item name="android:layout_marginStart">14dp</item>
        <item name="android:visibility">gone</item>
    </style>
    <style name="ThenRow">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">8dp</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:baselineAligned">true</item>
        <item name="android:visibility">gone</item>
    </style>
    <style name="ThenLabel" parent="LineBase">
        <item name="android:textSize">13sp</item>
        <item name="android:tag">w600</item>
        <item name="android:letterSpacing">0.14</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textColor">#8CFFFFFF</item>
    </style>
    <!-- THEN and LATER: three columns (time, match, competition), lined up across both rows in HomeLines -->
    <style name="ThenTime" parent="LineBase">
        <item name="android:textSize">15sp</item>
        <item name="android:tag">w400</item>
        <item name="android:textColor">#A6FFFFFF</item>
    </style>
    <style name="ThenMatch" parent="ThenTime">
        <item name="android:textColor">#B3FFFFFF</item>
        <item name="android:fontFeatureSettings">tnum</item>
    </style>
    <style name="ThenComp" parent="ThenTime" />
    <style name="CityName" parent="LineBase">
        <item name="android:textSize">12sp</item>
        <item name="android:tag">w600</item>
        <item name="android:letterSpacing">0.14</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textColor">#8CFFFFFF</item>
    </style>
    <style name="CityTemp" parent="LineBase">
        <item name="android:textSize">46sp</item>
        <item name="android:tag">w200</item>
        <item name="android:textColor">#FFFFFFFF</item>
        <item name="android:layout_marginTop">2dp</item>
    </style>
    <style name="CitySmall" parent="LineBase">
        <item name="android:textSize">13sp</item>
        <item name="android:tag">w400</item>
        <item name="android:textColor">#A6FFFFFF</item>
        <item name="android:layout_marginTop">2dp</item>
    </style>
    <style name="CityWord" parent="CitySmall">
        <item name="android:gravity">end</item>
        <item name="android:textColor">#FFFFC46B</item>
        <item name="android:layout_marginTop">4dp</item>
        <item name="android:visibility">gone</item>
    </style>
</resources>
