<?xml version="1.0" encoding="utf-8"?>
<!-- The sport and weather lines' styles (HomeLines.java), for the home screen and the Today app. -->
<resources>
    <!-- Home-screen lines (design B3): Outfit only, each weight fixed here, never changed while running. -->
    <style name="LineBase">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:fontFamily">@font/outfit</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:singleLine">true</item>
        <item name="android:ellipsize">none</item>
    </style>
    <style name="LineLabel" parent="LineBase">
        <item name="android:textSize">12sp</item>
        <item name="android:tag">w600</item>
        <item name="android:letterSpacing">0.14</item>
        <item name="android:textColor">#8CFFFFFF</item>
    </style>
    <style name="LineAsOf" parent="LineBase">
        <item name="android:textSize">12sp</item>
        <item name="android:tag">w600</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:textColor">#FFFFB347</item>
        <item name="android:layout_marginBottom">6dp</item>
    </style>
    <style name="HeadName" parent="LineBase">
        <item name="android:textSize">44sp</item>
        <item name="android:tag">w200</item>
        <item name="android:letterSpacing">-0.015</item>
        <item name="android:textColor">#FFFFFFFF</item>
    </style>
    <style name="HeadScore" parent="HeadName">
        <item name="android:tag">w600</item>
        <item name="android:layout_marginStart">17dp</item>
        <item name="android:layout_marginEnd">17dp</item>
        <item name="android:visibility">gone</item>
    </style>
    <style name="HeadV" parent="LineBase">
        <item name="android:textSize">19sp</item>
        <item name="android:tag">w600</item>
        <item name="android:letterSpacing">0.14</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textColor">#73FFFFFF</item>
        <item name="android:layout_marginStart">14dp</item>
        <item name="android:layout_marginEnd">14dp</item>
    </style>
    <style name="HeadLoc" parent="LineBase">
        <item name="android:textSize">20sp</item>
        <item name="android:tag">w400</item>
        <item name="android:textColor">#52FFFFFF</item>
        <item name="android:layout_marginStart">14dp</item>
        <item name="android:visibility">gone</item>
    </style>
    <style name="ThenRow">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">8dp</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:baselineAligned">true</item>
        <item name="android:visibility">gone</item>
    </style>
    <style name="ThenLabel" parent="LineBase">
        <item name="android:textSize">13sp</item>
        <item name="android:tag">w600</item>
        <item name="android:letterSpacing">0.14</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textColor">#8CFFFFFF</item>
    </style>
    <!-- THEN and LATER: three columns (time, match, competition), lined up across both rows in HomeLines -->
    <style name="ThenTime" parent="LineBase">
        <item name="android:textSize">15sp</item>
        <item name="android:tag">w400</item>
        <item name="android:textColor">#73FFFFFF</item>
    </style>
    <style name="ThenMatch" parent="ThenTime">
        <item name="android:textColor">#B3FFFFFF</item>
    </style>
    <style name="ThenComp" parent="ThenTime" />
    <style name="CityName" parent="LineBase">
        <item name="android:textSize">12sp</item>
        <item name="android:tag">w600</item>
        <item name="android:letterSpacing">0.14</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textColor">#8CFFFFFF</item>
    </style>
    <style name="CityTemp" parent="LineBase">
        <item name="android:textSize">46sp</item>
        <item name="android:tag">w200</item>
        <item name="android:textColor">#FFFFFFFF</item>
        <item name="android:layout_marginTop">2dp</item>
    </style>
    <style name="CitySmall" parent="LineBase">
        <item name="android:textSize">13sp</item>
        <item name="android:tag">w400</item>
        <item name="android:textColor">#73FFFFFF</item>
        <item name="android:layout_marginTop">2dp</item>
    </style>
    <style name="CityWord" parent="CitySmall">
        <item name="android:gravity">end</item>
        <item name="android:textColor">#FFFFC46B</item>
        <item name="android:layout_marginTop">4dp</item>
        <item name="android:visibility">gone</item>
    </style>
</resources>
