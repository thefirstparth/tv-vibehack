<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <!-- No activity: nothing to open, and no tile in the launcher's app grid. -->
    <application
        android:label="@string/app_name"
        android:allowBackup="false">

        <service
            android:name=".KeyService"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/key_service" />
        </service>

        <!-- Setting a button's job, from a computer only: it needs DUMP, which adb's shell has and apps can't get. -->
        <receiver
            android:name=".Setup"
            android:exported="true"
            android:permission="android.permission.DUMP" />
    </application>
</manifest>
