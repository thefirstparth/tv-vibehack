<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Weekly copy of the insights site's days to backup/insights/ (tools/insights-backup.sh): Sundays 10:00, or at the
     next wake if the Mac is asleep then.
     Turn on:  cp tools/insights-backup.plist ~/Library/LaunchAgents/page.bhatia.tv-insights-backup.plist
               launchctl load ~/Library/LaunchAgents/page.bhatia.tv-insights-backup.plist
     Turn off: launchctl unload ~/Library/LaunchAgents/page.bhatia.tv-insights-backup.plist, then delete that file. -->
<plist version="1.0">
<dict>
  <key>Label</key><string>page.bhatia.tv-insights-backup</string>
  <key>ProgramArguments</key>
  <array><string>/bin/bash</string><string>/Users/parthbhatia/tv-vibehack/tools/insights-backup.sh</string></array>
  <key>EnvironmentVariables</key><dict><key>PATH</key><string>/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin</string></dict>
  <key>StartCalendarInterval</key><dict><key>Weekday</key><integer>0</integer><key>Hour</key><integer>10</integer><key>Minute</key><integer>0</integer></dict>
  <key>StandardOutPath</key><string>/Users/parthbhatia/tv-vibehack/backup/insights/backup.log</string>
  <key>StandardErrorPath</key><string>/Users/parthbhatia/tv-vibehack/backup/insights/backup.log</string>
</dict>
</plist>
